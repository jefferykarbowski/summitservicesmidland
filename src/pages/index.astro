---
import Base from "../layouts/Base.astro";

const phoneOliver = "989-948-8955";
const phoneJackson = "989-708-5901";
const phoneOliverTel = "+19899488955";
const phoneJacksonTel = "+19897085901";
const instagram = "https://www.instagram.com/midland_summitservices/";
const cities = ["Midland", "Bay City", "Saginaw"];
---
<Base>
  <!-- ============ HEADER ============ -->
  <header class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-navy-100/60">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <a href="#top" class="flex items-center gap-3 group">
          <img
            src="/images/logo-circle.jpg"
            alt="Summit Services logo"
            width="44"
            height="44"
            class="h-11 w-11 rounded-full ring-2 ring-navy-100 shadow-sm transition group-hover:ring-accent-400"
          />
          <span class="hidden sm:block font-display text-lg font-bold text-navy-800 tracking-tight">
            Summit Services
          </span>
        </a>
        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-navy-700">
          <a href="#services" class="hover:text-sky-bright transition">Services</a>
          <a href="#service-area" class="hover:text-sky-bright transition">Service Area</a>
          <a href="#about" class="hover:text-sky-bright transition">About</a>
          <a href="#why" class="hover:text-sky-bright transition">Why Us</a>
        </nav>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded-full bg-accent-400 hover:bg-accent-500 px-4 py-2 text-sm font-bold text-navy-900 shadow-sm transition hover:shadow-md"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
            <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h2.879a1.5 1.5 0 0 1 1.06.44L9.06 3.94a1.5 1.5 0 0 1 .44 1.06v1.879a1.5 1.5 0 0 1-.44 1.06l-1.06 1.061a11.04 11.04 0 0 0 4 4l1.061-1.06a1.5 1.5 0 0 1 1.06-.44h1.879a1.5 1.5 0 0 1 1.06.44l1.5 1.5a1.5 1.5 0 0 1 .44 1.06V16.5A1.5 1.5 0 0 1 16.5 18h-1C7.492 18 2 12.508 2 5v-1.5Z" />
          </svg>
          Free Quote
        </a>
      </div>
    </div>
  </header>

  <main id="top">
    <!-- ============ HERO ============ -->
    <section class="hero-bg relative overflow-hidden">
      <!-- Floating decorative bubbles -->
      <div class="pointer-events-none absolute inset-0">
        <div class="bubble absolute top-24 right-12 w-3 h-3 rounded-full bg-sky-bright/40"></div>
        <div class="bubble absolute top-44 right-32 w-5 h-5 rounded-full bg-sky-bright/30" style="animation-delay:1.2s"></div>
        <div class="bubble absolute top-72 right-20 w-4 h-4 rounded-full bg-sky-bright/40" style="animation-delay:2.4s"></div>
        <div class="bubble absolute top-32 left-1/4 w-2 h-2 rounded-full bg-sky-bright/30" style="animation-delay:3s"></div>
      </div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-12 pb-20 sm:pt-20 sm:pb-32">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="text-center lg:text-left">
            <div class="inline-flex items-center gap-2 rounded-full bg-white/80 px-4 py-1.5 text-xs font-semibold text-navy-700 ring-1 ring-navy-100 shadow-sm">
              <span class="w-2 h-2 rounded-full bg-grass-500 animate-pulse"></span>
              Locally owned • Tri-City Michigan
            </div>
            <h1 class="mt-5 font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-navy-900 leading-[1.05]">
              Crystal-Clear Windows.<br />
              <span class="text-sky-bright">Crisp-Cut Lawns.</span>
            </h1>
            <p class="mt-5 text-lg text-navy-700 max-w-xl mx-auto lg:mx-0">
              Honest, dependable window washing and lawn care across the Tri-Cities. Run by Oliver Karbowski &amp; Jackson Larson — neighbors who treat your home like our own.
            </p>

            <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
              <a
                href="#contact"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-accent-400 hover:bg-accent-500 px-6 py-3.5 text-base font-bold text-navy-900 shadow-lg shadow-accent-400/30 transition"
              >
                Get a Free Quote
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                </svg>
              </a>
              <a
                href={`tel:${phoneOliverTel}`}
                class="inline-flex items-center justify-center gap-2 rounded-full bg-white hover:bg-navy-50 px-6 py-3.5 text-base font-semibold text-navy-800 ring-2 ring-navy-200 shadow-sm transition"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-sky-bright">
                  <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h2.879a1.5 1.5 0 0 1 1.06.44L9.06 3.94a1.5 1.5 0 0 1 .44 1.06v1.879a1.5 1.5 0 0 1-.44 1.06l-1.06 1.061a11.04 11.04 0 0 0 4 4l1.061-1.06a1.5 1.5 0 0 1 1.06-.44h1.879a1.5 1.5 0 0 1 1.06.44l1.5 1.5a1.5 1.5 0 0 1 .44 1.06V16.5A1.5 1.5 0 0 1 16.5 18h-1C7.492 18 2 12.508 2 5v-1.5Z" />
                </svg>
                Call {phoneOliver}
              </a>
            </div>

            <!-- Trust strip -->
            <div class="mt-10 flex flex-wrap justify-center lg:justify-start gap-x-7 gap-y-3 text-sm font-medium text-navy-700">
              <div class="flex items-center gap-2">
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-accent-500">
                  <path fill-rule="evenodd" d="M10 1.5a1 1 0 0 1 .894.553l2.236 4.472 4.943.717a1 1 0 0 1 .554 1.706l-3.575 3.486.844 4.92a1 1 0 0 1-1.45 1.054L10 15.93l-4.446 2.34a1 1 0 0 1-1.45-1.054l.844-4.92L1.373 8.948a1 1 0 0 1 .554-1.706l4.943-.717L9.106 2.053A1 1 0 0 1 10 1.5Z" clip-rule="evenodd" />
                </svg>
                Streak-Free Shine
              </div>
              <div class="flex items-center gap-2">
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-grass-600">
                  <path fill-rule="evenodd" d="M10 1.944A11.95 11.95 0 0 0 2.166 5.21a.75.75 0 0 0-.166.469v3.834c0 5.083 3.276 9.385 7.834 10.945a.75.75 0 0 0 .332 0C14.724 18.898 18 14.596 18 9.513V5.679a.75.75 0 0 0-.166-.469A11.95 11.95 0 0 0 10 1.944Zm3.78 7.225a.75.75 0 1 0-1.06-1.06l-3.97 3.97-1.47-1.47a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.06 0l4.5-4.5Z" clip-rule="evenodd" />
                </svg>
                Reliable &amp; Professional
              </div>
              <div class="flex items-center gap-2">
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-sky-bright">
                  <path d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v3.546L6.343 9.93a.75.75 0 0 0 1.06 1.06l2.97-2.97a.75.75 0 0 0 .22-.53V5Z" />
                </svg>
                Free Quotes &amp; Fast Reply
              </div>
            </div>
          </div>

          <!-- Logo / Visual -->
          <div class="relative flex justify-center lg:justify-end">
            <div class="relative">
              <div class="absolute -inset-6 rounded-full bg-gradient-to-tr from-sky-bright/20 to-accent-400/20 blur-2xl"></div>
              <img
                src="/images/logo-circle.jpg"
                alt="Summit Services circular brand mark"
                width="520"
                height="520"
                class="relative h-72 w-72 sm:h-80 sm:w-80 lg:h-[28rem] lg:w-[28rem] rounded-full shadow-2xl ring-8 ring-white"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SERVICES ============ -->
    <section id="services" class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-bright">What We Do</p>
          <h2 class="mt-3 font-display text-3xl sm:text-4xl font-extrabold text-navy-900">
            Two services. Done right.
          </h2>
          <p class="mt-4 text-navy-700">
            We keep things simple. Clean windows. Sharp lawns. Friendly faces who actually show up.
          </p>
        </div>

        <div class="mt-14 grid md:grid-cols-2 gap-7 max-w-5xl mx-auto">
          <!-- Window Washing -->
          <div class="card-hover relative overflow-hidden rounded-3xl bg-gradient-to-br from-sky-mist to-white border border-navy-100 p-8">
            <div class="absolute -top-10 -right-10 h-40 w-40 rounded-full bg-sky-bright/10"></div>
            <div class="relative">
              <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-sky-bright text-white shadow-lg shadow-sky-bright/30">
                <!-- squeegee / window icon -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7">
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <path d="M3 12h18" />
                  <path d="M12 3v18" />
                </svg>
              </div>
              <h3 class="mt-5 font-display text-2xl font-bold text-navy-900">Window Washing</h3>
              <p class="mt-2 text-navy-700">
                Streak-free, spot-free, photo-ready glass. Inside and out, screens and tracks too.
              </p>
              <ul class="mt-5 space-y-2 text-navy-800">
                {[
                  "Interior & exterior windows",
                  "Screens hand-cleaned",
                  "Sills & tracks wiped down",
                  "Hard-water spot treatment",
                ].map((item) => (
                  <li class="flex items-start gap-2">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 text-sky-bright shrink-0">
                      <path fill-rule="evenodd" d="M16.704 5.29a.75.75 0 0 1 .006 1.06l-7.5 7.75a.75.75 0 0 1-1.08.006L3.29 9.346a.75.75 0 1 1 1.07-1.052l3.288 3.345 6.997-7.234a.75.75 0 0 1 1.06-.115Z" clip-rule="evenodd" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <a href="#contact" class="mt-7 inline-flex items-center gap-1.5 text-sm font-bold text-sky-bright hover:text-navy-800 transition">
                Get a free window quote
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" /></svg>
              </a>
            </div>
          </div>

          <!-- Lawn Care -->
          <div class="card-hover relative overflow-hidden rounded-3xl bg-gradient-to-br from-green-50 to-white border border-navy-100 p-8">
            <div class="absolute -top-10 -right-10 h-40 w-40 rounded-full bg-grass-500/10"></div>
            <div class="relative">
              <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-grass-600 text-white shadow-lg shadow-grass-600/30">
                <!-- grass icon -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7">
                  <path d="M12 20v-8"/>
                  <path d="M6 20v-6c0-3 2-5 6-8"/>
                  <path d="M18 20v-6c0-3-2-5-6-8"/>
                  <path d="M3 20h18"/>
                </svg>
              </div>
              <h3 class="mt-5 font-display text-2xl font-bold text-navy-900">Lawn Mowing &amp; Care</h3>
              <p class="mt-2 text-navy-700">
                Crisp lines, clean edges, no surprises. Weekly or one-time visits welcome.
              </p>
              <ul class="mt-5 space-y-2 text-navy-800">
                {[
                  "Mowing & striped patterns",
                  "Edging walks & driveways",
                  "Trimming around beds & fences",
                  "Clippings cleaned up — every time",
                ].map((item) => (
                  <li class="flex items-start gap-2">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 text-grass-600 shrink-0">
                      <path fill-rule="evenodd" d="M16.704 5.29a.75.75 0 0 1 .006 1.06l-7.5 7.75a.75.75 0 0 1-1.08.006L3.29 9.346a.75.75 0 1 1 1.07-1.052l3.288 3.345 6.997-7.234a.75.75 0 0 1 1.06-.115Z" clip-rule="evenodd" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <a href="#contact" class="mt-7 inline-flex items-center gap-1.5 text-sm font-bold text-grass-600 hover:text-navy-800 transition">
                Get a free lawn quote
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" /></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SERVICE AREA ============ -->
    <section id="service-area" class="py-20 sm:py-28 bg-navy-50/40">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-bright">Where We Work</p>
          <h2 class="mt-3 font-display text-3xl sm:text-4xl font-extrabold text-navy-900">
            Proudly serving the Tri-Cities
          </h2>
          <p class="mt-4 text-navy-700">
            Based in Midland and on the road in Bay City and Saginaw. If you're in or near these cities, we'll be there.
          </p>
        </div>

        <div class="mt-12 grid sm:grid-cols-3 gap-5 max-w-4xl mx-auto">
          {cities.map((city) => (
            <div class="card-hover rounded-2xl bg-white p-7 text-center border border-navy-100">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-navy-800 text-white">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <h3 class="mt-4 font-display text-xl font-bold text-navy-900">{city}, MI</h3>
              <p class="mt-1 text-sm text-navy-600">Residential service</p>
            </div>
          ))}
        </div>

        <p class="mt-10 text-center text-sm text-navy-600">
          Not sure if we cover your neighborhood? <a href="#contact" class="font-semibold text-sky-bright hover:underline">Ask us — we probably do.</a>
        </p>
      </div>
    </section>

    <!-- ============ ABOUT / TEAM ============ -->
    <section id="about" class="py-20 sm:py-28 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="order-2 lg:order-1">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-bright">Meet the Team</p>
            <h2 class="mt-3 font-display text-3xl sm:text-4xl font-extrabold text-navy-900">
              Oliver &amp; Jackson — two hardworking Midland locals.
            </h2>
            <p class="mt-5 text-navy-700 text-lg">
              Summit Services is owned and run by Oliver Karbowski and Jackson Larson — friends, neighbors, and the guys who'll actually be on your property.
            </p>
            <p class="mt-4 text-navy-700">
              We started this business because we love working outside, taking pride in a job done right, and getting to know the people we serve. When we wash your windows or cut your grass, we're putting our name on it — literally.
            </p>

            <div class="mt-8 grid sm:grid-cols-2 gap-4">
              <div class="rounded-xl bg-navy-50/60 p-4 border border-navy-100">
                <p class="text-xs font-semibold uppercase tracking-wider text-navy-500">Owner</p>
                <p class="mt-1 font-bold text-navy-900">Oliver Karbowski</p>
                <a href={`tel:${phoneOliverTel}`} class="text-sm text-sky-bright hover:underline">{phoneOliver}</a>
              </div>
              <div class="rounded-xl bg-navy-50/60 p-4 border border-navy-100">
                <p class="text-xs font-semibold uppercase tracking-wider text-navy-500">Owner</p>
                <p class="mt-1 font-bold text-navy-900">Jackson Larson</p>
                <a href={`tel:${phoneJacksonTel}`} class="text-sm text-sky-bright hover:underline">{phoneJackson}</a>
              </div>
            </div>
          </div>

          <div class="order-1 lg:order-2 relative">
            <div class="absolute -inset-4 rounded-3xl bg-gradient-to-tr from-sky-bright/20 to-accent-400/20 blur-2xl"></div>
            <div class="relative aspect-[3/4] max-w-md mx-auto lg:mx-0 lg:ml-auto rounded-3xl overflow-hidden shadow-2xl ring-8 ring-white">
              <img
                src="/images/team-oliver-jackson.png"
                alt="Oliver Karbowski and Jackson Larson on the job — washing windows on a ladder"
                width="900"
                height="1200"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="absolute -bottom-4 right-4 lg:right-0 bg-accent-400 text-navy-900 font-bold px-5 py-3 rounded-2xl shadow-xl">
              On the job 💪
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ WHY US ============ -->
    <section id="why" class="py-20 sm:py-28 bg-navy-800 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-30">
        <div class="absolute top-10 right-20 w-72 h-72 rounded-full bg-sky-bright/30 blur-3xl"></div>
        <div class="absolute bottom-10 left-10 w-72 h-72 rounded-full bg-accent-400/20 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent-400">Why Summit</p>
          <h2 class="mt-3 font-display text-3xl sm:text-4xl font-extrabold">
            The kind of service your neighbors talk about.
          </h2>
        </div>

        <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            {
              title: "Local & Honest",
              body: "We live here. We answer our own phones. No call centers, no runaround.",
              icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z"/></svg>`
            },
            {
              title: "Quality You Can See",
              body: "Streak-free glass and clean lines. If something's not right, we'll fix it.",
              icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>`
            },
            {
              title: "Reliable Schedule",
              body: "When we say we'll be there, we'll be there. Same-week starts when possible.",
              icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`
            },
            {
              title: "Fair, Up-Front Pricing",
              body: "Free quotes. No mystery fees. You'll know the price before we start.",
              icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-7 w-7"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`
            },
          ].map((item) => (
            <div class="rounded-2xl bg-white/5 backdrop-blur-sm border border-white/10 p-6 hover:bg-white/10 transition">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-400 text-navy-900">
                <Fragment set:html={item.icon} />
              </div>
              <h3 class="mt-4 font-display text-lg font-bold">{item.title}</h3>
              <p class="mt-2 text-sm text-navy-100/90 leading-relaxed">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CONTACT ============ -->
    <section id="contact" class="py-20 sm:py-28 bg-gradient-to-b from-white to-sky-mist/60">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-bright">Get in Touch</p>
          <h2 class="mt-3 font-display text-3xl sm:text-4xl font-extrabold text-navy-900">
            Ready for a free quote?
          </h2>
          <p class="mt-4 text-navy-700 text-lg max-w-2xl mx-auto">
            Tap a number to call or text. We usually reply within the hour.
          </p>
        </div>

        <div class="mt-12 grid md:grid-cols-2 gap-6">
          <a
            href={`tel:${phoneOliverTel}`}
